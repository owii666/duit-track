# ========================================================
# Duittrack - ENVIRONMENT VARIABLES TEMPLATE
# ========================================================
# Salin file ini menjadi ".env.local" untuk konfigurasi lokal.
# JANGAN PERNAH mengunggah file ".env" atau ".env.local" ke GitHub.
#
# Catatan Arsitektur:
# Aplikasi ini berjalan secara Client-side Offline-First menggunakan
# IndexedDB bawaan browser, sehingga tidak memerlukan database URL
# atau API key wajib untuk menjalankan fitur inti secara lokal maupun di Vercel.
# ========================================================

# Port server development lokal (Opsional - default: 3000)
PORT=3000

# URL Publik Aplikasi (Opsional - digunakan untuk PWA share / OAuth jika ada)
VITE_APP_URL="http://localhost:3000"

# Gemini AI API Key (Opsional - untuk integrasi asisten finansial cerdas di masa mendatang)
# Dapatkan API key gratis di: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=""
